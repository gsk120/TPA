{
  "name": "family-personal-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.js",
    "setup": "node --env-file-if-exists=.env src/setup.js",
    "doctor": "node --env-file-if-exists=.env src/setup.js doctor",
    "discover": "node --env-file-if-exists=.env src/setup.js discover",
    "backup": "node --env-file-if-exists=.env src/setup.js backup",
    "import": "node --env-file-if-exists=.env src/setup.js import",
    "test": "node --test test/*.test.js",
    "check": "node --test test/*.test.js",
    "bot:start": "node src/control.js start",
    "bot:stop": "node src/control.js stop",
    "bot:status": "node src/control.js status",
    "bot:logs": "node src/control.js logs",
    "bot:restart": "node src/control.js restart"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12"
  }
}
