# npm run setup가 빈 .env를 생성합니다. 실제 값은 채팅에 보내지 마세요.
# Supabase 신규 프로젝트 Connect의 Session pooler 연결문자열.
# SQL에서 만든 assistant_app 전용 로그인 사용. 관리자 postgres 계정은 실행에 사용하지 않습니다.
DATABASE_URL=
# Supabase CA 인증서 파일. 설정하면 TLS 인증서 검증을 수행합니다.
DATABASE_CA_FILE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_IDS=
# 최초 한 번 생성해서 계속 유지할 가족 UUID (npm run setup에서 생성)
FAMILY_ID=
# 선택: codex.exe 경로. npm 설치본은 CODEX_JS에 codex.js 진입 경로 지정.
CODEX_EXECUTABLE=
CODEX_JS=
# 비워두면 CLI 기본 모델 사용
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=180
# 멘션·봇 답장·명령어만 처리. all이면 BotFather privacy 설정도 변경 필요.
MESSAGE_MODE=addressed
SCHEDULER_ENABLED=true
